# ============================================================
# Roster GTS — environment variables
# Copy this file to `.env.local` and fill the values.
# Never commit `.env.local` to git.
# ============================================================

# --- Self-hosted Supabase di PC Anda ---
# Setelah `supabase start`, ambil nilai dari output terminal.
# GANTI 192.168.1.50 dengan IP IPv4 PC Anda (cek dengan `ipconfig`).
# Pakai IP, JANGAN localhost — supaya HP/laptop lain di WiFi yang sama bisa connect.

VITE_SUPABASE_URL=http://192.168.1.50:54321
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...REPLACE_ME

# --- Server-side only (jangan kasih prefix VITE_) ---
SUPABASE_URL=http://192.168.1.50:54321
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...REPLACE_ME
